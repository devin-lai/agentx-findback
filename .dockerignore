# Send only files consumed by Dockerfile to the build context.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!uv.lock
!README.md
!LICENSE
!NOTICE
!THIRD_PARTY_NOTICES.md
!src/
!src/**
!web/
!web/package.json
!web/package-lock.json
!web/index.html
!web/tsconfig.json
!web/vite.config.ts
!web/license-notices.js
!web/svelte.config.js
!web/src/
!web/src/**
!web/public/
!web/public/**

# Deny private files even inside an allowed source tree.
**/.*
**/.*/**
**/private/**
**/personal/**
**/plans/**
**/secrets/**
**/secrets.*
**/credentials/**
**/credentials.*
