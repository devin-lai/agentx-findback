# Copy to .env. Keep secrets out of version control.
# These are generic defaults. The evaluated DGX Spark profile (planner, reviewer and guarded
# SAM 2.1 settings) is listed in docs/DEPLOYMENT.md under "Spark competition profile".
AGENTX_DATA_DIR=.agentx
# Required for any public/network deployment. Generate with: openssl rand -hex 32
AGENTX_API_TOKEN=
# Optional second token for Skills and MCP agents: read recordings, runs, frames and reports and
# ask questions; every other change is refused (HTTP 403). Needs AGENTX_API_TOKEN as well.
AGENTX_AGENT_TOKEN=
# Optional explicit database URL; defaults to SQLite inside AGENTX_DATA_DIR.
# AGENTX_DATABASE_URL=postgresql+psycopg://user:password@localhost/agentx
# Tool-agent planner: any OpenAI-compatible chat endpoint with JSON mode. On the DGX Spark node this
# is NVIDIA Nemotron served by vLLM on loopback. Leave the model empty to use the local rule resolver.
AGENTX_PLANNER_BASE_URL=http://127.0.0.1:8000/v1
AGENTX_PLANNER_MODEL=
AGENTX_PLANNER_API_KEY=
AGENTX_PLANNER_MAX_STEPS=8
AGENTX_PLANNER_MAX_TOKENS=1200
# Optional Nemotron/vLLM extension; omit for providers that do not accept chat_template_kwargs.
# AGENTX_PLANNER_THINKING=false
# Legacy aliases for a hosted StepFun planner; used only when the planner variables above are empty.
AGENTX_STEPFUN_BASE_URL=https://api.stepfun.com/v1
AGENTX_STEPFUN_MODEL=
AGENTX_STEPFUN_API_KEY=
# Optional for StepFun 3.7 Flash; pair with AGENTX_PLANNER_MAX_TOKENS=4096.
# AGENTX_STEPFUN_REASONING_EFFORT=low
# Choose http (a separate inference service such as vLLM) or transformers (an existing local checkpoint).
# The base Cosmos model serves visual review, the `cosmos` perception backend and
# open-vocabulary registration suggestions. No extra setting enables suggestions.
AGENTX_COSMOS_BACKEND=http
AGENTX_COSMOS_BASE_URL=
AGENTX_COSMOS_MODEL=nvidia/Cosmos-Reason2-8B
AGENTX_COSMOS_API_KEY=
# Optional reference-crop reviewer candidate: the base must also report presence before this
# adapter's point is accepted. Freeform reviews, discovery and indexing keep the base model.
# Leave empty unless a prospective validation supports the adapter and veto rule.
AGENTX_COSMOS_REFERENCE_ADAPTER_MODEL=
# Native inference uses optional vision dependencies and never downloads a checkpoint.
AGENTX_COSMOS_MODEL_PATH=
AGENTX_COSMOS_DEVICE=auto
AGENTX_COSMOS_MAX_EDGE=448
# Optional evaluated reference-crop review contract; other review/indexing modes are unchanged.
AGENTX_COSMOS_REFERENCE_GROUNDING=normalized
# To enable the tested Cosmos-Reason2-8B configuration, use integer_1000 above and:
# AGENTX_COSMOS_REFERENCE_MAX_EDGE=768
# Zoomed second look at each coarse point: off, refine or confirm. Measured on the frozen
# inspected development cohort and left off: re-asking at ~3x resolution reproduces the model's own point
# to within 0.3% of the frame, for roughly twice the inference.
AGENTX_COSMOS_FOCUS=off
# AGENTX_COSMOS_FOCUS_WINDOW=0.34
# HTTP workers within a single grounded review (1–8); native inference stays serial.
AGENTX_COSMOS_REVIEW_WORKERS=4
AGENTX_COSMOS_MAX_NEW_TOKENS=1024
# Free-form reviews may reason inside <think> tags first (slower). Grounded reviews never do.
AGENTX_COSMOS_THINKING=false
# Upper sampling rate when memory is built by the Cosmos grounding backend (one request per object and frame).
AGENTX_COSMOS_INDEX_FPS=1
# HTTP timeout / native per-attempt generation soft limit; excludes native model loading.
AGENTX_PROVIDER_TIMEOUT_SECONDS=90
# Match this directory to the frontend production build.
AGENTX_WEB_DIST=web/dist
AGENTX_DETECTOR_MODEL=PekingU/rtdetr_r18vd
AGENTX_DETECTOR_REVISION=ac77a11ff0170a41b771c03264987f8ce2b0d753
# Appearance identity for RT-DETR detections (DINOv2): several objects per category, explicit ambiguity.
AGENTX_IDENTITY_ENABLED=false
AGENTX_IDENTITY_MODEL=facebook/dinov2-small
AGENTX_IDENTITY_REVISION=ed25f3a31f01632728cabb09d1542f84ab7b0056
AGENTX_IDENTITY_MODEL_PATH=
AGENTX_IDENTITY_THRESHOLD=0.6
AGENTX_IDENTITY_MARGIN=0.05
# Optional SAM 2.1 temporal tracking. Uses cached weights only; never downloads during indexing.
# Install the pinned checkpoint with scripts/spark/download_sam2.py on the assigned Spark.
AGENTX_SAM2_MODEL_PATH=
AGENTX_SAM2_MODEL=facebook/sam2.1-hiera-small
AGENTX_SAM2_REVISION=ee5bba1d82bb8749febdf90f45e84b687142ba03
AGENTX_SAM2_MEMORY_FRAMES=32
AGENTX_SAM2_PRESENCE_THRESHOLD=0.5
# Below this presence score, a candidate also needs appearance similarity to a confirmed view.
# Enable AGENTX_IDENTITY_ENABLED for that DINOv2 check; otherwise low-presence masks abstain.
AGENTX_SAM2_CONFIDENT_PRESENCE=0.95
AGENTX_SAM2_APPEARANCE_THRESHOLD=0.7

# Optional conservative look-alike tracking. Requires cached RT-DETR weights.
# Track up to four nearby same-category objects from the first registration frame.
# After a collision, identity stays uncertain; a new explicit reference is needed.
AGENTX_SAM2_DISTRACTOR_GUARD=false
AGENTX_SAM2_MAX_DISTRACTORS=4

# Opt in only for planners supporting JSON-schema constrained responses (tested on Spark vLLM).
AGENTX_PLANNER_STRUCTURED_OUTPUTS=false

# Optional NVIDIA/vLLM selection reasoning, requiring --reasoning-parser nemotron_v3.
# Only indirect-description selection uses this budget; direct tool steps are unchanged.
# Leave unset for generic endpoints. The total selection cap reserves 1024 answer tokens.
# AGENTX_PLANNER_SELECTION_THINKING_BUDGET=512

# Live camera capture (browser camera or `agentx live-push`); frames over HTTP, sealed on stop.
# AGENTX_LIVE_ENABLED=true
# AGENTX_LIVE_MAX_FPS=10
# AGENTX_LIVE_MAX_EDGE=1280
# AGENTX_LIVE_IDLE_SEAL_SECONDS=120
